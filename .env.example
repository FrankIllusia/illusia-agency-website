# ── Shop / Shopify Storefront ────────────────────────────────────────────────
# Until both DOMAIN and TOKEN are set, /shop runs off the seed catalogue in
# lib/shop/seed.ts and checkout reports "not live" instead of failing.
# See docs/SHOP.md for the full launch checklist.

# your-store.myshopify.com — no protocol, no trailing slash
SHOPIFY_STORE_DOMAIN=

# Public Storefront API token from the Shopify "Headless" channel.
# Needs unauthenticated_read_product_listings + _product_inventory.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# The one collection the storefront renders. Products outside it stay invisible
# to the site. This is the curation switch — change membership in Shopify admin.
SHOPIFY_SHOP_COLLECTION=illusia-shop

# Optional. Shopify ships an API version each quarter and supports each for a
# year; override here when the pinned default nears end of life.
# SHOPIFY_API_VERSION=2026-07
